{
  "name": "jamp3",
  "version": "0.6.2",
  "author": "ffalt",
  "license": "MIT",
  "description": "mp3, id3v1, id3v2 - reader & writer",
  "keywords": [
    "mp3",
    "ID3",
    "ID3v1",
    "ID3v2",
    "nodejs",
    "cli"
  ],
  "bin": {
    "mp3-analyze": "bin/analyzeMP3.js",
    "id3v2-dump": "bin/dumpID3v2.js",
    "id3v1-dump": "bin/dumpID3v1.js",
    "id3v1-remove": "bin/removeID3v1.js"
  },
  "scripts": {
    "clean": "rm -Rf dist",
    "build": "npm run clean && npm run build:dist",
    "build:dist": "tsc",
    "build:deploy": "npm run build",
    "build:docs": "typedoc --options typedoc.json && touch ./docs/.nojekyll",
    "test": "jest",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "check": "qlty check --all",
    "release": "npx commit-and-tag-version -a",
    "coverage": "jest --coverage",
    "releaselog": "node .github/scripts/extract-release.mjs"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "bin",
    "dist",
    "src",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ffalt/jamp3.git"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "commander": "15.1.0",
    "fs-extra": "11.4.1",
    "iconv-lite": "0.7.3",
    "memory-stream": "1.0.0"
  },
  "overrides": {
    "brace-expansion": "5.1.0",
    "minimatch": "11.0.9",
    "glob": "14.0.6",
    "test-exclude": "8.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "6.0.1",
    "@types/fs-extra": "11.0.4",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.11",
    "@types/tmp": "0.2.6",
    "eslint": "10.15.0",
    "eslint-plugin-jest": "29.17.1",
    "eslint-plugin-unicorn": "80.0.0",
    "jest": "30.5.2",
    "tmp": "0.2.7",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "typedoc": "0.28.20",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0"
  },
  "commit-and-tag-version": {
    "header": "# Changelog\n\nAll notable changes to this project will be documented in this file.",
    "packageFiles": [
      {
        "filename": "package.json",
        "type": "json"
      }
    ],
    "bumpFiles": [
      {
        "filename": "package.json",
        "type": "json"
      }
    ]
  }
}
